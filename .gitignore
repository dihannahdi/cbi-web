.vscode/
cbi-pages-full-60/

# claude git worktrees (transient, not source)
.claude/worktrees/

# strapi runtime uploads (backend user content, not source)
cbi-backend/public/uploads/

# credentials — never commit (2026-09-07 git-hygiene audit). client_secret.json
# is a Google OAuth client secret, token.json holds a live access+refresh
# token; logs/ is the monitor's runtime output.
scripts/gsc-sheets-monitor/client_secret.json
scripts/gsc-sheets-monitor/token.json
scripts/gsc-sheets-monitor/logs/

# real production secrets are pasted verbatim in this analysis doc
# (APP_KEYS/ADMIN_JWT_SECRET/API_TOKEN_SALT/TRANSFER_TOKEN_SALT from
# /opt/cbi-strapi/.env, captured 2026-09-07) — do not track until redacted.
docs/VPS_INFRASTRUCTURE_ANALYSIS.md

# private WhatsApp exports (real staff names, internal conversations) and
# the two backlog documents derived directly from them — not source, and
# the same privacy reasoning as the exports themselves.
wa-chat/
docs/CBI_JOBDESC_BACKLOG_2026-08-19.docx
docs/AGENT_BRIEF_JOBDESC_BACKLOG_2026-08-19.md

# design-system reference export (~128MB, tool-generated, duplicated as its
# own .zip) — not source, too large to carry in git history.
refferences/

# Playwright MCP tool session artifacts (browser console logs / page
# snapshots) — transient debug output, not source.
.playwright-mcp/

# one-off debug/scratch scripts and their output dumps (superseded by a
# clean same-named script, or self-declared disposable via a tmp_ prefix)
scripts/tmp_*.py
scripts/snapshot.json
scripts/snapshot2.json
scripts/tabs-output.txt
scripts/check-strapi2.sh
scripts/check-strapi3.sh
scripts/check-strapi4.sh
